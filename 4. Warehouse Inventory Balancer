class InventoryBalancer {
    void analyzeInventory(int[] sectionA, int[] sectionB) {

        int sumA = 0, sumB = 0;

        // Calculate totals
        for (int i = 0; i < sectionA.length; i++) {
            sumA += sectionA[i];
            sumB += sectionB[i];
        }

        // Check balance
        String status = (sumA == sumB) ? "Balanced" : "Not Balanced";

        // Find highest quantity
        int max = sectionA[0];
        String section = "Section A";
        int index = 0;

        // Check Section A
        for (int i = 0; i < sectionA.length; i++) {
            if (sectionA[i] > max) {
                max = sectionA[i];
                section = "Section A";
                index = i;
            }
        }

        // Check Section B
        for (int i = 0; i < sectionB.length; i++) {
            if (sectionB[i] > max) {
                max = sectionB[i];
                section = "Section B";
                index = i;
            }
        }

        // Output
        System.out.println("Section A Total: " + sumA +
                " | Section B Total: " + sumB +
                " | Status: " + status +
                " | Highest Quantity: " + max +
                " (" + section + ", Item " + (index + 1) + ")");
    }

    public static void main(String[] args) {
        InventoryBalancer obj = new InventoryBalancer();

        int[] sectionA = {20, 15, 30};
        int[] sectionB = {25, 10, 30};

        obj.analyzeInventory(sectionA, sectionB);
    }
}
