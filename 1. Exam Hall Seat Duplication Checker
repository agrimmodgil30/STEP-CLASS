class SeatChecker {
    void checkDuplicateSeats(int[] seatNumbers) {
        boolean found = false;

        for (int i = 0; i < seatNumbers.length; i++) {
            for (int j = i + 1; j < seatNumbers.length; j++) {
                if (seatNumbers[i] == seatNumbers[j]) {
                    System.out.println("Duplicate Seat Number Found: " + seatNumbers[i]);
                    found = true;
                    break; // avoid printing same duplicate multiple times
                }
            }
        }

        if (!found) {
            System.out.println("No Duplicate Seats Found");
        }
    }

    public static void main(String[] args) {
        SeatChecker obj = new SeatChecker();

        int[] arr1 = {101, 102, 103, 102, 105};
        obj.checkDuplicateSeats(arr1);

        int[] arr2 = {101, 102, 103, 104, 105};
        obj.checkDuplicateSeats(arr2);
    }
}
